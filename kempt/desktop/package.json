{
  "name": "kempt-desktop",
  "productName": "Project Victor Charlie",
  "version": "0.1.0",
  "description": "Desktop app for a Kempt chat server",
  "main": "main.js",
  "private": true,
  "author": "credence29-2",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.credence.kempt",
    "productName": "Project Victor Charlie",
    "executableName": "VictorCharlie",
    "files": ["main.js", "preload.js", "setup.html", "keys.js", "build/icon.png", "build/tray.png", "build/badge.png"],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "VictorCharlie-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "VictorCharlie-Portable-${version}.exe"
    }
  }
}
